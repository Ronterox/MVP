package main

type Post struct {
	Title   string
	Date    string
	Summary string
}

templ Site(title string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/styles.css"/>
			<link href="https://fonts.googleapis.com/css2?family=Varela+Round&display=swap" rel="stylesheet"/>
		</head>
		<body>
			@Container()
			<script src="/static/script.js"></script>
		</body>
	</html>
}

templ Container() {
	<div class="container">
		@Header()
		@Navigation()
		<main>
			@Welcome()
			@About()
			@Blog([]Post{
				{
					Title:   "Guía para Principiantes",
					Date:    "25 Abril 2025",
					Summary: "Todo lo que necesitas saber para empezar tu viaje como femboy...",
				},
				{
					Title:   "Aqui esta tu potote bby",
					Date:    "25 Abril 2025",
					Summary: "Como hacer un potote bby",
				},
				{
					Title:   "¡Hola! 👋",
					Date:    "25 Abril 2025",
					Summary: "¡Hola! 👋",
				},
			})
		</main>
		@Footer()
	</div>
}

templ Header() {
	<header>
		<h1 class="site-title">✨ Femboy Club ✨</h1>
		<div class="header-decoration"></div>
	</header>
}

templ Navigation() {
	<nav class="navigation">
		<a href="#home" class="nav-item">🏠 Inicio</a>
		<a href="#about" class="nav-item">💖 Sobre Nosotros</a>
		<a href="#blog" class="nav-item">📝 Blog</a>
		<a href="#members" class="nav-item">👥 Miembros</a>
		<a href="#gallery" class="nav-item">🖼️ Galería</a>
	</nav>
}

templ Welcome() {
	<section id="welcome" class="content-box">
		<h2>¡Bienvenidos! 💕</h2>
		<p>
			Bienvenido a nuestro rincón especial dedicado a la comunidad femboy. Un espacio seguro donde podemos ser
			nosotros
			mismos, compartir experiencias y celebrar nuestra forma de ser.
		</p>
	</section>
}

templ About() {
	<section id="about" class="content-box">
		<h2>Sobre Nuestro Club 🌸</h2>
		<p>Somos una comunidad dedicada a celebrar y apoyar a los femboys. Aquí encontrarás:</p>
		<ul>
			<li>💫 Un espacio seguro y acogedor</li>
			<li>💝 Consejos de estilo y moda</li>
			<li>🤗 Apoyo mutuo y amistad</li>
			<li>✨ Eventos y encuentros</li>
		</ul>
	</section>
}

templ Blog(posts []Post) {
	<section id="blog" class="content-box">
		<h2>Blog 📝</h2>
		<div class="blog-preview">
			for _, post := range posts {
				@BlogPost(post)
			}
		</div>
	</section>
}

templ BlogPost(post Post) {
	<article class="blog-post">
		<h3>{ post.Title }</h3>
		<p class="post-date">{ post.Date }</p>
		<p>{ post.Summary }</p>
	</article>
}

templ Footer() {
	<footer>
		<p>✨ Femboy Club 2025 ✨</p>
		<div class="footer-decoration"></div>
	</footer>
}
